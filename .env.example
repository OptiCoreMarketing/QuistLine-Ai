GROQ_API_KEY=gsk_din_groq_api_nogle_her
PORT=3000

# System of record fra trin 1 (spec/83-beslutninger-database-taerskler).
# Kør `npm run migrate` efter denne er sat, før serveren startes første gang.
# Lokalt: postgres://bruger:adgangskode@localhost:5432/quistline
# Railway: connection string fra Railway-projektets Postgres-plugin.
DATABASE_URL=postgres://bruger:adgangskode@localhost:5432/quistline

# Stopgap-auth for /api/tasks og /api/agent (se kommentar i server.js).
# Sæt til en lang, tilfældig streng. Uden denne er begge endpoints åbne.
OWNER_API_KEY=saet-en-lang-tilfaeldig-vaerdi-her

# Valgfri — override for rate-limit stopgap. Default er 20 hvis udeladt.
RATE_LIMIT_PER_MINUTE=20
