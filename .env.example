GROQ_API_KEY=gsk_din_groq_api_nogle_her
PORT=3000

# Krævet af src/server.js (connectToDatabase) — brugt i dag, men udfases
# til Postgres ved trin 1, jf. spec addendum "beslutninger-database-taerskler".
MONGODB_URI=mongodb+srv://bruger:adgangskode@cluster.mongodb.net/quistline

# Stopgap-auth for /api/tasks og /api/agent (se kommentar i server.js).
# Sæt til en lang, tilfældig streng. Uden denne er begge endpoints åbne.
OWNER_API_KEY=saet-en-lang-tilfaeldig-vaerdi-her

# Valgfri — override for rate-limit stopgap. Default er 20 hvis udeladt.
RATE_LIMIT_PER_MINUTE=20
